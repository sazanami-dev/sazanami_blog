# ============================================================
# Astro SSR 開発用 Dockerfile
# ============================================================
# ホットリロード対応: ソースコードをボリュームマウントして即時反映
# ============================================================

FROM node:22-alpine

RUN apk add --no-cache libc6-compat

WORKDIR /app

# 依存関係のインストール
COPY package.json package-lock.json ./
RUN npm install

ENV NODE_ENV=development

EXPOSE 3000

CMD ["npm", "run", "dev", "--", "--force"]
