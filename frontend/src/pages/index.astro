---
import { fetchFromStrapi } from '../utils/strapi';

// Strapiから「posts」の一覧を取得。
// カテゴリ(category)やタグ(tags)、アイキャッチ(coverImage)も一緒に取るために populate=* を指定します
const response = await fetchFromStrapi('posts', { query: 'populate=*' });
const posts = response.data;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>サークルブログ</title>
    <style>
      body { font-family: sans-serif; max-width: 800px; margin: 0 auto; padding: 20px; }
      .post-card { border: 1px solid #ccc; padding: 15px; margin-bottom: 15px; border-radius: 8px; }
      .meta { color: #666; font-size: 0.9em; }
    </style>
  </head>
  <body>
    <h1>サークルブログ</h1>
    
    {posts.length === 0 ? (
      <p>記事がありません。</p>
    ) : (
      posts.map((post: any) => (
        <div class="post-card">
          <h2>{post.title}</h2>
          <div class="meta">
            <span>投稿日: {new Date(post.publishedAt).toLocaleDateString('ja-JP')}</span> | 
            <span> カテゴリ: {post.category?.name || '未分類'}</span>
          </div>
          <p>投稿者: サークル編集部</p> {/* プランBに基づく固定表示 */}
        </div>
      ))
    )}
  </body>
</html>