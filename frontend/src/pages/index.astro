---
import { fetchPosts } from '../utils/strapi';

// Strapiから「posts」の一覧を取得（カテゴリ・タグ・アイキャッチ含む）
const { data: posts } = await fetchPosts();
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>サークルブログ</title>
    <style>
      body { font-family: sans-serif; max-width: 800px; margin: 0 auto; padding: 20px; }
      .post-card { border: 1px solid #ccc; padding: 15px; margin-bottom: 15px; border-radius: 8px; }
      .post-card h2 { margin-top: 0; }
      .post-card h2 a { color: #333; text-decoration: none; }
      .post-card h2 a:hover { text-decoration: underline; color: #0076ff; }
      .meta { color: #666; font-size: 0.9em; }
    </style>
  </head>
  <body>
    <h1>サークルブログ</h1>
    
    {posts.length === 0 ? (
      <p>記事がありません。</p>
    ) : (
      posts.map((post) => (
        <div class="post-card">
          <h2>
            <a href={`/blog/${post.slug ?? post.documentId}`}>
              {post.title}
            </a>
          </h2>
          <div class="meta">
            <span>投稿日: {post.publishedAt ? new Date(post.publishedAt).toLocaleDateString('ja-JP') : '未公開'}</span> | 
            <span> カテゴリ: {post.category?.name ?? '未分類'}</span>
          </div>
          <p>投稿者: サークル編集部</p>
        </div>
      ))
    )}
  </body>
</html>