---
import Layout from '../layouts/Layout.astro';
import { BlogList } from '../components/BlogList';
import { fetchPosts } from '../utils/strapi';

import type { StrapiPost } from '../types/strapi.types';

let posts: StrapiPost[] = [];
let error = null;

try {
  const response = await fetchPosts();
  posts = response?.data || [];
} catch (e) {
  console.error("Failed to fetch posts from Strapi:", e);
  error = e instanceof Error ? e.message : "不明な接続エラー";
}

const strapiUrl = import.meta.env.STRAPI_PUBLIC_URL
  || (typeof process !== 'undefined' ? process.env.STRAPI_PUBLIC_URL : undefined)
  || import.meta.env.STRAPI_URL
  || (typeof process !== 'undefined' ? process.env.STRAPI_URL : undefined);
---

<Layout title="Sazanami Blog | 記事一覧">
  {error && (
    <div class="max-w-5xl mx-auto px-4 mt-8">
      <div class="bg-amber-50 border border-amber-200 text-amber-800 px-5 py-4 rounded-2xl text-sm shadow-sm" role="alert">
        <h3 class="font-bold flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-amber-600" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
          </svg>
          バックエンドとのデータ同期エラー
        </h3>
        <p class="mt-2 text-xs opacity-90">
          記事データの取得に失敗しました。管理者画面でAPIトークンの設定等をご確認ください。<br />
          詳細: {error}
        </p>
      </div>
    </div>
  )}
  <BlogList posts={posts} strapiUrl={strapiUrl} />
</Layout>