---
import type { GetStaticPaths } from 'astro';
import BlogPost from '../../layouts/BlogPost.astro';
import { fetchPosts, fetchPostByDocumentId } from '../../utils/strapi';

export const getStaticPaths = (async () => {
	const { data: posts } = await fetchPosts();
	return posts.map((post) => ({
		params: { slug: post.slug ?? post.documentId },
		props: { documentId: post.documentId },
	}));
}) satisfies GetStaticPaths;

const { documentId } = Astro.props;
const { data: post } = await fetchPostByDocumentId(documentId);
---

<BlogPost
	title={post.title}
	publishedAt={post.publishedAt}
	content={post.content}
	coverImage={post.coverImage}
	category={post.category}
	tags={post.tags}
>
	<div class="content">
		{
			post.content &&
				post.content.map((block) => {
					if (block.type === 'paragraph') {
						return (
							<p>
								{block.children
									?.map((child) => child.text)
									.join('')}
							</p>
						);
					}
					if (block.type === 'heading') {
						const HeadingTag = `h${block.level || 2}` as any;
						return (
							<HeadingTag>
								{block.children
									?.map((child) => child.text)
									.join('')}
							</HeadingTag>
						);
					}
					return null;
				})
		}
	</div>
</BlogPost>
