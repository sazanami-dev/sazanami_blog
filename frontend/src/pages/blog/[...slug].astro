---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import BlogPost from '../../layouts/BlogPost.astro';
import { fetchPosts, fetchPostByDocumentId } from '../../utils/strapi';

export const getStaticPaths = (async () => {
	const { data: posts } = await fetchPosts();
	return posts.map((post) => ({
		params: { slug: post.slug ?? post.documentId },
		props: { documentId: post.documentId },
	}));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { documentId } = Astro.props;
const { data: post } = await fetchPostByDocumentId(documentId);
---

<BlogPost
	title={post.title}
	publishedAt={post.publishedAt}
	content={post.content}
	coverImage={post.coverImage}
	category={post.category}
	tags={post.tags}
>
	<Fragment set:html={post.content ?? ''} />
</BlogPost>
