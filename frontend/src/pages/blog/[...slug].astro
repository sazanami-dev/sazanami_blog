---
import Layout from '../../layouts/Layout.astro';
import { fetchPostBySlug, fetchPostByDocumentId } from '../../utils/strapi';
import type { StrapiPost } from '../../types/strapi.types';

const { slug } = Astro.params;

if (!slug) {
	return Astro.redirect('/404');
}

let post: StrapiPost | null = null;

// 1. まずslugとして検索する
try {
	const { data: posts } = await fetchPostBySlug(slug);
	if (posts && posts.length > 0) {
		post = posts[0];
	}
} catch (e) {
	// Ignore
}

// 2. 見つからなければ、documentIdとして直接フェッチを試みる
if (!post) {
	try {
		const { data } = await fetchPostByDocumentId(slug);
		post = data;
	} catch (e) {
		// Ignore
	}
}

// それでも存在しない場合は404ページへリダイレクト
if (!post) {
	return Astro.redirect('/404');
}

const strapiUrl = import.meta.env.STRAPI_URL;
const coverImageUrl = post.coverImage ? `${strapiUrl}${post.coverImage.url}` : null;
---

<Layout title={`${post.title} | Sazanami Blog`}>
  <div class="article-container">
    <a href="/" class="back-link">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
      記事一覧に戻る
    </a>

    <article class="glass-panel article-card">
      {coverImageUrl && (
        <div class="article-hero-image" style={`background-image: url(${coverImageUrl})`} />
      )}
      
      <div class="article-body">
        <div class="article-meta">
          {post.category && <span class="category-badge">{post.category.name}</span>}
          <span class="pub-date">
            {post.publishedAt ? new Date(post.publishedAt).toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' }) : '未公開'}
          </span>
        </div>

        <h1 class="article-title">{post.title}</h1>

        {post.tags && post.tags.length > 0 && (
          <div class="article-tags">
            {post.tags.map((tag) => (
              <span class="tag-badge">#{tag.Name}</span>
            ))}
          </div>
        )}

        <hr class="separator" />

        <div class="prose">
          {
            post.content &&
              post.content.map((block) => {
                if (block.type === 'paragraph') {
                  return (
                    <p>
                      {block.children
                        ?.map((child) => child.text)
                        .join('')}
                    </p>
                  );
                }
                if (block.type === 'heading') {
                  const HeadingTag = `h${block.level || 2}` as any;
                  return (
                    <HeadingTag>
                      {block.children
                        ?.map((child) => child.text)
                        .join('')}
                    </HeadingTag>
                  );
                }
                return null;
              })
          }
        </div>
      </div>
    </article>
  </div>
</Layout>

<style>
  .article-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 1rem 0;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-secondary);
    font-weight: 600;
    margin-bottom: 2rem;
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .back-link:hover {
    color: var(--accent-blue);
    transform: translateX(-4px);
  }
  .article-card {
    overflow: hidden;
  }
  .article-hero-image {
    height: 380px;
    background-size: cover;
    background-position: center;
    border-bottom: 1px solid var(--panel-border);
  }
  .article-body {
    padding: 3rem;
  }
  .article-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
  }
  .category-badge {
    background: rgba(96, 165, 250, 0.15);
    color: var(--accent-blue);
    padding: 0.25rem 0.75rem;
    border-radius: 6px;
    font-weight: 600;
  }
  .pub-date {
    color: var(--text-secondary);
  }
  .article-title {
    font-size: 2.25rem;
    line-height: 1.3;
    margin-bottom: 1.5rem;
    color: #fff;
  }
  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  .tag-badge {
    font-size: 0.85rem;
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.05);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
  }
  .separator {
    border: none;
    border-top: 1px solid var(--panel-border);
    margin: 2rem 0;
  }

  /* Prose content formatting */
  .prose {
    font-size: 1.1rem;
    line-height: 1.85;
    color: var(--text-primary);
  }
  .prose :global(p) {
    margin-bottom: 1.75rem;
  }
  .prose :global(h2) {
    font-size: 1.6rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--panel-border);
    padding-bottom: 0.5rem;
  }
  .prose :global(h3) {
    font-size: 1.3rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  @media (max-width: 768px) {
    .article-hero-image {
      height: 240px;
    }
    .article-body {
      padding: 1.5rem;
    }
    .article-title {
      font-size: 1.75rem;
    }
  }
</style>
