# ============================================================
# 本番環境用の環境変数テンプレート
# ============================================================
# このファイルをコピーして .env を作成し、値を書き換えてください。
# .env ファイルは絶対にリポジトリにコミットしないでください。
# ============================================================

# --- Strapi (バックエンド) ---
# ※ backend/.env に設定する値と同じものです。
# docker-compose.yml から参照される変数のみここに記載しています。

# ブラウザから Strapi にアクセスする際の公開URL
# 例: https://api.yourdomain.com
STRAPI_PUBLIC_URL=http://localhost:1337

# Strapi のポート番号（ホスト側）
STRAPI_PORT=1337

# --- Astro (フロントエンド) ---

# Strapi の API トークン（Strapi管理画面で発行）
STRAPI_TOKEN=your_strapi_api_token_here

# フロントエンドのポート番号（ホスト側）
FRONTEND_PORT=3000
